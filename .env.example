# Copy to .env.local for development, and add each value in Vercel → Project → Settings → Environment Variables.
# Nothing here is required to run locally: without DATABASE_URL an embedded database is used, and without
# Firebase the login accepts the test code 1234 (development only, never in production).

# --- Database (Neon) -----------------------------------------------------------
# Neon dashboard → your project → Connect → choose the pooled connection string.
DATABASE_URL=

# --- Site ------------------------------------------------------------------------
# Your domain, with https and no trailing slash. Used for sitemap, social previews and canonical links.
NEXT_PUBLIC_SITE_URL=https://www.example.in

# Gmail addresses that become store owners the first time they log in with Google (comma-separated).
OWNER_EMAILS=owner@gmail.com
# Developer test login only (no Firebase): mobile numbers that become owners with the code 1234.
OWNER_PHONES=+919876543210

# --- Login: Google sign-in through Firebase (free Spark plan) -------------------
# Firebase console → Project settings → General → Your apps → Web app config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Online payments: Razorpay (optional until KYC is approved) -----------------
# Razorpay dashboard → Account & Settings → API keys. Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard → Webhooks → secret you choose when adding https://<domain>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
